# Copy to .env (never commit .env) and fill in both passwords.

# Password of the PostgreSQL admin role "postgres". Used only to initialize the database.
POSTGRES_PASSWORD=change-me-admin

# Password of the least-privilege game role "army" that the server connects with.
DB_PASSWORD=change-me-game

# Host port players connect to (default 19149). Uncomment to change it if 19149 is taken.
# GAME_PORT=19149
