# Copy to .env (never commit .env) and fill in both passwords.

# Password of the PostgreSQL admin role "postgres". Used only to initialize the database.
POSTGRES_PASSWORD=change-me-admin

# Password of the least-privilege game role "army" that the server connects with.
DB_PASSWORD=change-me-game

# Host port players connect to (default 19149). Uncomment to change it if 19149 is taken.
# GAME_PORT=19149

# --- Web client (spec 002-web-client). All optional; defaults shown. ---

# local  = plain HTTP for this machine/LAN (default)
# public = HTTPS for internet players: needs WEB_DOMAIN and docker/web/certs/{fullchain,privkey}.pem
# WEB_MODE=local

# Domain the certificate is for (public mode only).
# WEB_DOMAIN=game.example.com

# Host ports for the web client. Local default: http://localhost:8080
# Public mode: set WEB_PORT=80 and WEB_TLS_PORT=443.
# WEB_PORT=8080
# WEB_TLS_PORT=8443

# Per-visitor limits on game connections (by IP): simultaneous sessions, and new sessions per minute.
# WEB_MAX_CONN_PER_IP=4
# WEB_CONN_RATE=10r/m
