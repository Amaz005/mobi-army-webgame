# Local mode (WEB_MODE=local): plain HTTP. Browsers allow ws:// to localhost.
# ${...} values are filled from the environment by the nginx image (envsubst).

# Behind Cloudflare Tunnel every request comes from the cloudflared container; use the visitor IP that
# Cloudflare sends instead, so the per-IP limits below apply per visitor. Trusted only from cloudflared's
# fixed address (docker-compose.yml › networks.tunnel); direct requests can't spoof the header.
set_real_ip_from 172.29.252.2;
real_ip_header CF-Connecting-IP;

limit_conn_zone $binary_remote_addr zone=game_conn:10m;
limit_req_zone  $binary_remote_addr zone=game_rate:10m rate=${WEB_CONN_RATE};

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

log_format game '$remote_addr [$time_local] "$request" $status $body_bytes_sent $request_time';

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;

    location = / {
        add_header Cache-Control "no-cache";
        try_files /index.html =404;
    }

    location ~ ^/(client\.js|play\.css|keypad\.js|index\.html)$ {
        add_header Cache-Control "no-cache";
    }

    # One WebSocket = one game session (contracts/web-endpoints.md › /game).
    location = /game {
        access_log /var/log/nginx/access.log game;
        limit_conn game_conn ${WEB_MAX_CONN_PER_IP};
        limit_conn_status 503;
        limit_req zone=game_rate burst=5 nodelay;
        limit_req_status 429;

        proxy_pass http://relay:6080;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 1d;
        proxy_send_timeout 1d;
    }

    location / {
        return 404;
    }
}
