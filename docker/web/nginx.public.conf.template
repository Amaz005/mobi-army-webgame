# Public mode (WEB_MODE=public): HTTPS for players on the internet (spec FR-012).
# Container ports: 8080 = HTTP (redirect + ACME), 8443 = HTTPS. Publish them as 80/443 via
# WEB_PORT=80 and WEB_TLS_PORT=443 in .env. Certificates: docker/web/certs/{fullchain,privkey}.pem.
# ${...} values are filled from the environment by the nginx image (envsubst).

limit_conn_zone $binary_remote_addr zone=game_conn:10m;
limit_req_zone  $binary_remote_addr zone=game_rate:10m rate=${WEB_CONN_RATE};

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

log_format game '$remote_addr [$time_local] "$request" $status $body_bytes_sent $request_time';

server {
    listen 8080;
    server_name ${WEB_DOMAIN};
    server_tokens off;

    location /.well-known/acme-challenge/ {
        root /var/www/acme;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 8443 ssl;
    http2 on;
    server_name ${WEB_DOMAIN};
    root /usr/share/nginx/html;
    server_tokens off;

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:SSL:10m;
    add_header Strict-Transport-Security "max-age=31536000" always;

    location = / {
        add_header Cache-Control "no-cache";
        try_files /index.html =404;
    }

    location ~ ^/(client\.js|play\.css|keypad\.js|index\.html)$ {
        add_header Cache-Control "no-cache";
    }

    # Icons (specs/003-web-icon): revalidated each visit, so a changed icon shows up after a release.
    location ~ ^/(favicon\.ico|icon-192\.png|icon-512\.png|apple-touch-icon\.png)$ {
        add_header Cache-Control "no-cache";
    }

    # nginx's mime.types has no entry for .webmanifest.
    location = /manifest.webmanifest {
        default_type application/manifest+json;
        add_header Cache-Control "no-cache";
    }

    # One WebSocket = one game session (contracts/web-endpoints.md › /game).
    location = /game {
        access_log /var/log/nginx/access.log game;
        limit_conn game_conn ${WEB_MAX_CONN_PER_IP};
        limit_conn_status 503;
        limit_req zone=game_rate burst=5 nodelay;
        limit_req_status 429;

        proxy_pass http://relay:6080;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 1d;
        proxy_send_timeout 1d;
    }

    location / {
        return 404;
    }
}
