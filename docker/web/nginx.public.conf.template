# Public mode (WEB_MODE=public): HTTPS for players on the internet (spec FR-012).
# Container ports: 8080 = HTTP (redirect + ACME), 8443 = HTTPS. Publish them as 80/443 via
# WEB_PORT=80 and WEB_TLS_PORT=443 in .env. Certificates: docker/web/certs/{fullchain,privkey}.pem.
# ${...} values are filled from the environment by the nginx image (envsubst).
# URL layout: specs/004-game-portal/contracts/web-endpoints.md (portal at /, play page /<id>/choi/, MobiArmy client at /mobiarmy/client/).
# The locations in the HTTPS server are the same as in nginx.local.conf.template; keep both in sync.

limit_conn_zone $binary_remote_addr zone=game_conn:10m;
limit_req_zone  $binary_remote_addr zone=game_rate:10m rate=${WEB_CONN_RATE};
limit_req_zone  $binary_remote_addr zone=portal_api:10m rate=${WEB_API_RATE};

# Online count is cached briefly so a busy home page doesn't reach the game server on every view.
proxy_cache_path /var/cache/nginx/portal levels=1 keys_zone=portal_status:1m max_size=1m inactive=1m;

# Docker's DNS: the game server is looked up per request, so nginx starts even when it is down.
resolver 127.0.0.11 valid=10s ipv6=off;

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

log_format game '$remote_addr [$time_local] "$request" $status $body_bytes_sent $request_time';

server {
    listen 8080;
    server_name ${WEB_DOMAIN};
    server_tokens off;

    location /.well-known/acme-challenge/ {
        root /var/www/acme;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 8443 ssl;
    http2 on;
    server_name ${WEB_DOMAIN};
    root /usr/share/nginx/portal;
    server_tokens off;
    absolute_redirect off;

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:SSL:10m;
    add_header Strict-Transport-Security "max-age=31536000" always;
    # --- Portal (specs/004-game-portal) ---

    location = / {
        add_header Cache-Control "no-cache";
        try_files /index.html =404;
    }

    location ~ ^/(portal\.css|portal\.js|game\.html|play\.html|games\.json)$ {
        add_header Cache-Control "no-cache";
    }

    # Card pictures and hosted game files (contracts/game-catalog.md).
    location ^~ /games/ {
    }

    # Shared game page for every catalog id; api, game and games are reserved.
    location ~ ^/(?!(api|game|games)/)[a-z0-9-]+/$ {
        add_header Cache-Control "no-cache";
        try_files /game.html =404;
    }

    location ~ ^/(?!(api|game|games)$)[a-z0-9-]+$ {
        return 301 $uri/;
    }

    # Play page: the game inside the portal layout (the game itself is the catalog playUrl, framed).
    location ~ ^/(?!(api|game|games)/)[a-z0-9-]+/choi/$ {
        add_header Cache-Control "no-cache";
        try_files /play.html =404;
    }

    location ~ ^/(?!(api|game|games)/)[a-z0-9-]+/choi$ {
        return 301 $uri/;
    }

    # Icons (specs/003-web-icon), generated with the game client, also used by the portal.
    location ~ ^/(favicon\.ico|icon-192\.png|icon-512\.png|apple-touch-icon\.png)$ {
        root /usr/share/nginx/html/mobiarmy/client;
        add_header Cache-Control "no-cache";
    }

    # --- MobiArmy web client (spec 002), moved from / ---

    location = /mobiarmy/client {
        return 301 /mobiarmy/client/;
    }

    location = /mobiarmy/client/ {
        root /usr/share/nginx/html;
        add_header Cache-Control "no-cache";
        try_files /mobiarmy/client/index.html =404;
    }

    location ~ ^/mobiarmy/client/(client\.js|play\.css|keypad\.js|index\.html|favicon\.ico|icon-192\.png|icon-512\.png|apple-touch-icon\.png)$ {
        root /usr/share/nginx/html;
        add_header Cache-Control "no-cache";
    }

    # nginx's mime.types has no entry for .webmanifest.
    location = /mobiarmy/client/manifest.webmanifest {
        root /usr/share/nginx/html;
        default_type application/manifest+json;
        add_header Cache-Control "no-cache";
    }

    # Old game addresses (FR-007).
    location = /index.html {
        return 301 /mobiarmy/choi/;
    }

    location ~ ^/(client\.js|play\.css|keypad\.js|manifest\.webmanifest)$ {
        return 301 /mobiarmy/client/$1;
    }

    # One WebSocket = one game session (specs/002-web-client/contracts/web-endpoints.md › /game).
    location = /game {
        access_log /var/log/nginx/access.log game;
        limit_conn game_conn ${WEB_MAX_CONN_PER_IP};
        limit_conn_status 503;
        limit_req zone=game_rate burst=5 nodelay;
        limit_req_status 429;

        proxy_pass http://relay:6080;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 1d;
        proxy_send_timeout 1d;
    }

    # --- Portal API in the game server (specs/004-game-portal/contracts/portal-api.md) ---

    location = /api/mobiarmy/status {
        # No per-IP limit here: answers come from the 10 s cache, and many players may share one IP.
        error_page 502 503 504 = @api_offline;

        proxy_cache portal_status;
        proxy_cache_valid 200 10s;
        proxy_ignore_headers Cache-Control Set-Cookie;
        set $portal_api http://server:8081;
        proxy_pass $portal_api;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location /api/ {
        limit_req zone=portal_api burst=10 nodelay;
        limit_req_status 429;
        error_page 429 = @api_limited;
        error_page 502 503 504 = @api_offline;
        client_max_body_size 8k;

        set $portal_api http://server:8081;
        proxy_pass $portal_api;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location @api_limited {
        default_type application/json;
        return 429 '{"error":"too_many","message":"Bạn thử quá nhiều lần, vui lòng đợi rồi thử lại."}';
    }

    location @api_offline {
        default_type application/json;
        return 502 '{"error":"server_offline","message":"Máy chủ tạm dừng."}';
    }

    location / {
        return 404;
    }
}
